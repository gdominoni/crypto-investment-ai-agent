# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Exchange: Binance (start with TESTNET keys) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Macro data ---
FRED_API_KEY=

# --- News ingestion ---
CRYPTOCOMPARE_API_KEY=

# --- Execution mode (safety default: always dry-run until explicit Telegram override) ---
DRY_RUN=true
