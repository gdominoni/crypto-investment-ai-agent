# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Exchange: Binance Spot (start with TESTNET keys, from testnet.binance.vision) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Exchange: Binance Futures Testnet (Module A perpetual leg) ---
# A SEPARATE sandbox from Spot Testnet above -- separate site, separate
# account, separate keys. Get these from testnet.binancefuture.com, not
# testnet.binance.vision. See modules/module_a_cash_carry/README.md.
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# --- Hummingbot (Module A) ---
# A LOCAL password that encrypts Hummingbot's own credential/config files
# on disk -- not an exchange API key, you choose this value yourself.
HUMMINGBOT_CONFIG_PASSWORD=

# --- Macro data ---
FRED_API_KEY=

# --- News ingestion ---
CRYPTOCOMPARE_API_KEY=

# --- Execution mode (safety default: always dry-run until explicit Telegram override) ---
DRY_RUN=true
