# --- Secrets & credentials ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Databases & runtime state ---
*.sqlite3
*.db
*.db-journal
data/**/*.csv
data/**/*.parquet
!data/.gitkeep
safety/state/

# --- Logs ---
*.log
logs/

# --- Framework runtime dirs (large / instance-specific / regenerable) ---
# Applies to any modules/*/user_data (Freqtrade) tree -- config.json and
# strategies/ are tracked, downloaded candles and backtest output are not.
**/user_data/data/
**/user_data/backtest_results/
**/user_data/logs/
**/user_data/notebooks/.ipynb_checkpoints/
**/user_data/hyperopt_results/
**/user_data/models/
**/user_data/hyperopt.lock

# Module C's bespoke training pipeline output (train.py) -- regenerable by
# running the training script; the signal it produces is data, not code.
**/user_data/signal_output/

# Module B's coarse-grid sweep (run_coarse_grid.py) overwrites each
# strategy's auto-loaded parameter file once per combo -- whatever's left
# on disk after a run is just the last combo tested, not a meaningful
# artifact (unlike trend_ema_adx.json, hyperopt's deliberate "best
# params" output, which stays tracked). The real output is
# coarse_grid_results.csv, which is tracked.
modules/module_b_trend_following/user_data/strategies/mean_reversion_bb_rsi.json
modules/module_b_trend_following/user_data/strategies/volatility_breakout_kc_squeeze.json
modules/module_b_trend_following/user_data/strategies/volume_driven_vwap_cmf.json

# Hummingbot (Module A): conf/strategies/*.yml is hand-authored and tracked;
# everything else under conf/ is generated locally (encrypted credentials,
# client config, password-verification file) and must never be committed.
modules/module_a_cash_carry/conf/connectors/
modules/module_a_cash_carry/conf/.password_verification
modules/module_a_cash_carry/conf/conf_client.yml
modules/module_a_cash_carry/conf/conf_fee_overrides.yml
modules/module_a_cash_carry/conf/hummingbot_logs.yml
modules/module_a_cash_carry/data/
modules/module_a_cash_carry/logs/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Claude Code session/tooling state ---
.claude/

# --- Docker ---
docker-compose.override.yml
